# Project HUNT — environment template
# Copy to .env and fill in only the keys you need. NEVER commit .env.
# Every variable in this file is OPTIONAL — the app boots and serves
# traffic with no configuration at all. Setting a key unlocks the
# corresponding module; missing key → module is hidden or shows a
# "key required" chip in the UI.
#
# To enable a paid module locally, paste your key after the "=" sign,
# e.g.   SHODAN_API_KEY=ABCDEFG...

# --- Database ------------------------------------------------------------
# Required on Vercel. Serverless functions have no writable FS, so
# SQLite would lose data between cold starts. Use any hosted Postgres:
#   Neon:     https://neon.tech  (recommended, free tier)
#   Supabase: https://supabase.com
#   Vercel:   https://vercel.com/postgres
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME

# --- OSINT provider keys (all optional) ---------------------------------
# Every key is empty by default. Visit each provider to obtain a key.
# SHODAN_API_KEY=          # https://developer.shodan.io/api
# HIBP_API_KEY=            # https://haveibeenpwned.com/API/v3
# VIRUSTOTAL_API_KEY=      # https://docs.virustotal.com/
# GREYNOISE_API_KEY=       # https://docs.greynoise.io/
# SECURITYTRAILS_API_KEY=  # https://docs.securitytrails.com/
# IPINFO_API_KEY=          # https://ipinfo.io/developers (optional; 50k/mo free)
# MALTEGO_API_KEY=         # https://docs.maltego.com/
# FACTCHECKTOOLS_API_KEY=  # https://developers.google.com/fact-check/tools/api

# --- RFC 3161 trusted timestamping (optional) ----------------------------
# Comma-separated TSA chain. Default is the free public FreeTSA.
TSA_URLS=https://freetsa.org/tsr,http://timestamp.digicert.com
# When true, refuse to log a payload whose TSA stamp is untrusted.
TSA_REQUIRED=false
# Per-TSA hard timeout in seconds.
TSA_TIMEOUT_SECONDS=3.0

# --- App ----------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
